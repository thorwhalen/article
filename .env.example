# article — configuration & secrets (copy to `.env`; never commit the real .env)
# Loaded by article.config.Settings via pydantic-settings.
# Every platform is optional: omit a platform's secrets to skip it.

# --- Substack (Phase 1, primary; drafts only) ---------------------------------
# Public URL of your publication; the canonical SSOT URL is derived from it.
SUBSTACK_PUBLICATION_URL=https://yourname.substack.com
# Auth, first one set wins. The cookie header copied from a logged-in browser:
SUBSTACK_COOKIES=
# ... or a JSON file of cookies:
SUBSTACK_COOKIES_PATH=
# ... or email + password (accounts that have a password):
SUBSTACK_EMAIL=
SUBSTACK_PASSWORD=

# --- Medium (Phase 2) --------------------------------------------------------
# Nothing to set: Medium's API is closed to new integrations, so the adapter
# prints the "Import a story" step instead of posting.

# --- Dev.to / Forem (Phase 2) ------------------------------------------------
# Generate at https://dev.to/settings/extensions ("DEV API Keys").
DEVTO_API_KEY=

# --- Hashnode (Phase 2) ------------------------------------------------------
# Personal Access Token from https://hashnode.com/settings/developer
HASHNODE_TOKEN=
# Publication ObjectId (query `publication(host: "...") { id }`).
HASHNODE_PUBLICATION_ID=

# --- Pipeline ----------------------------------------------------------------
# JSON state store; the canonical_url SSOT lives here, keyed by article slug.
STATE_PATH=pipeline_state.json
